# ==============================================================================
# E-FORM KABUPATEN PURBALINGGA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# General
APP_ENV=development
APP_PORT=8088
FRONTEND_PORT=3002
APP_SECRET=purbalingga-super-secret-key-change-in-production-min32chars
APP_URL=http://localhost:8088

# PostgreSQL Database (Host port 5433 to avoid conflict with local 5432)
DB_HOST=postgres
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=purbalinggapass
DB_NAME=eform_purbalingga
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:purbalinggapass@postgres:5432/eform_purbalingga?sslmode=disable

# File Upload Settings
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=10

# Integrasi API Sidami Purbalingga (Live Proxy)
SIDAMI_API_BASE=https://api.sidami.purbalinggakab.go.id/api

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8088/api/v1
NEXT_PUBLIC_APP_NAME="E-Form Kabupaten Purbalingga"
NEXT_PUBLIC_STORAGE_URL=http://localhost:8088/uploads
